{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omas-projets",
  "main": "src/index.js",
  "compatibility_date": "2026-01-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "keep_vars": true,
  "triggers": { "crons": ["0 7 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omas-projets",
      "database_id": "3913ffcc-a29c-4bd0-b0f6-11ede6cd0ead",
      "migrations_dir": "migrations"
    }
  ]
}
