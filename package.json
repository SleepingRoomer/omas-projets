{
  "name": "omas-projets",
  "version": "0.1.0",
  "description": "Cap par OMAS Île-de-France : déclaration, validation et suivi des projets de la localité",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply omas-projets --local",
    "db:migrate:prod": "wrangler d1 migrations apply omas-projets --remote",
    "deploy": "wrangler deploy",
    "test": "node --test tests/"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  },
  "private": true,
  "type": "module"
}
